  "info": {
    "description": "GPCR-G-protein MD web resource \u2014 222 active-state ternary complex simulations.\n\n**Open access**: No login required. All data, downloads, and API endpoints are freely accessible. Optional API keys provide higher rate limits only.\n\n**Citation**: Huang J et al., CoupledMD, Nucleic Acids Research (2026). DOI pending (pre-publication).\n\n**Licence**: Data CC-BY-4.0, Code MIT.",
    "title": "CoupledMD",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
