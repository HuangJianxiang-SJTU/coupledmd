# Data artifacts (bind-mounted at runtime, not baked into the image).
data/
db/
*.sqlite

# Frontend build output and node_modules (nginx serves the dist/).
frontend/node_modules/
frontend/dist/

# Environment and secrets.
.env
certs/

# Python cache.
__pycache__/
*.pyc
*.pyo

# IDE / editor.
.vscode/
.idea/

# Docker / compose.
docker-compose.yml
Dockerfile

# Nginx config (mounted into the nginx container, not the API container).
nginx/

# Documentation / plan files (not needed at runtime).
*.html
*.md
