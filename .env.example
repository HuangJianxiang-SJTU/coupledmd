# Copy to .env and adjust for your environment.
# All host-specific values come from here; nothing is hardcoded in scripts.

# Absolute path to the read-only analysis-layer source directory.
ANALYSIS_SRC=/MDdata/data02/jxhuang/gpcr_g/a

# Absolute path to the project root (where data/, db/, api/, frontend/ live).
DATA_ROOT=/MDdata/data02/jxhuang/gpcr_g/gpcr_g_server

# Database connection string. Switch to postgresql://user:pass@host/db for Postgres.
DATABASE_URL=sqlite:///db/coupledmd.sqlite

# API base URL exposed to the frontend. Never hardcode a hostname.
API_BASE_URL=http://localhost:8000

# Port the API server listens on (inside the container).
API_PORT=8000

# Port nginx listens on (the public-facing HTTP port).
HTTP_PORT=80

# Port nginx listens on for HTTPS.
HTTPS_PORT=443

# Directory containing SSL certificates (fullchain.pem + privkey.pem).
# For self-signed dev certs: ./certs
# For Let's Encrypt: /etc/letsencrypt/live/<domain>
SSL_CERT_DIR=./certs

# Comma-separated list of origins allowed to make cross-origin API requests.
# In production nginx serves both frontend and API from the same origin, so
# this can stay empty.  For local development with the Vite dev server:
#   CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# Rate limiting: Tier-0 (anonymous) and Tier-1 (API key) limits.
RATE_LIMIT_TIER0=60/minute
RATE_LIMIT_TIER1=600/minute

# Path to the API keys SQLite database. In docker compose this is overridden
# to /data/state/keys.db (a writable named volume, separate from the
# read-only analysis mount). Locally it defaults to <DATA_ROOT>/data/keys.db.
KEYS_DB_PATH=./data/keys.db

# Path to the optional accounts SQLite database. Same volume logic as above
# (container: /data/state/accounts.db).
ACCOUNTS_DB_PATH=./data/accounts.db
