# Copy to .env and adjust for your environment.
# All host-specific values come from here; nothing is hardcoded in scripts.

# Absolute path to the read-only analysis-layer source directory.
ANALYSIS_SRC=/MDdata/data02/jxhuang/gpcr_g/a

# Absolute path to the project root (where data/, db/, api/, frontend/ live).
DATA_ROOT=/MDdata/data02/jxhuang/gpcr_g/gpcr_g_server

# Database connection string. Switch to postgresql://user:pass@host/db for Postgres.
DATABASE_URL=sqlite:///db/coupledmd.sqlite

# API base URL exposed to the frontend. Never hardcode a hostname.
API_BASE_URL=http://localhost:8000

# Port the API server listens on.
API_PORT=8000
